[Unit]
Description=Hermes Telegram Bridge
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
# Load secrets from an environment file (copy sample.env here).
EnvironmentFile=/etc/hermes-bridge.env
ExecStart=/usr/bin/python3 /opt/telegram_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
