# Copy this file to /etc/hermes-bridge.env and fill in your values.
# NEVER commit real tokens/keys to version control.

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional: Google AI API key for image understanding (free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use for vision
GEMINI_MODEL=gemini-3.5-flash

# Optional: Path to the Hermes CLI
HERMES_BIN=/usr/local/bin/hermes

# Optional: Comma-separated Telegram user IDs to allow, or * for everyone
# (leave empty to allow everyone)
TELEGRAM_ALLOWED_USERS=
